{
  "name": "scavi-monorepo",
  "version": "0.1.4-dev.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -b && pnpm build:cli && pnpm build:action",
    "build:cli": "pnpm --filter scavi-cli bundle",
    "build:action": "pnpm --filter @scavi/github-action bundle",
    "check": "pnpm build && node packages/cli/dist/index.js check",
    "test": "vitest run",
    "typecheck": "tsc -b --pretty false",
    "eval:semantic": "pnpm build && node scripts/semantic-eval.mjs --retrieval-only",
    "eval:semantic:openai": "pnpm build && node scripts/semantic-eval.mjs --provider openai --model gpt-5-mini",
    "eval:semantic:ollama": "pnpm build && node scripts/semantic-eval.mjs --provider ollama"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vitest": "^3.2.0"
  }
}
